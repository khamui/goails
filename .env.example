# Goails environment — copy to .env.local and fill in.
# .env.local is gitignored; this file is the committed template.

# --- Generation / routing model (provider-agnostic, ADR-0003) ---

# Which provider to use: "google" (default) or "anthropic".
GOAILS_MODEL_PROVIDER=google

# Optional: override the model id. Defaults:
#   google    -> gemini-3.8-flash   (free tier, no credit card)
#   anthropic -> claude-sonnet-5-5  (billed to a Claude API key)
# GOAILS_MODEL_ID=gemini-3.8-flash

# Google Gemini API key (required when GOAILS_MODEL_PROVIDER=google).
# Get a free key, no credit card, at https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# Anthropic API key (required only when GOAILS_MODEL_PROVIDER=anthropic).
# Separate from a Claude Pro subscription. https://platform.claude.com
# ANTHROPIC_API_KEY=
